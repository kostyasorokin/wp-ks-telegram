<?xml version="1.0"?>
<ruleset name="KS Telegram">
    <description>WordPress coding standards for KS Telegram.</description>
    <arg name="extensions" value="php"/>
    <file>ks-telegram.php</file>
    <file>src</file>
    <file>templates</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <rule ref="WordPress"/>
    <config name="minimum_supported_wp_version" value="6.7"/>
    <config name="testVersion" value="8.4-"/>
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
</ruleset>
